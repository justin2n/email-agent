<tr><td style="padding:0;">
<img src="{{ image_url }}" alt="{{ image_alt }}" width="600" style="display:block;width:100%;max-width:600px;border:0;border-radius:8px 8px 0 0;" />
</td></tr>
<tr><td style="padding:32px 40px 8px 40px;font-family:Arial,Helvetica,sans-serif;">
<h1 style="margin:0;font-size:28px;line-height:34px;font-weight:bold;color:#1E1E1E;">{{ headline }}</h1>
{% if subhead %}<p style="margin:12px 0 0 0;font-size:16px;line-height:24px;color:#767676;">{{ subhead }}</p>{% endif %}
</td></tr>
