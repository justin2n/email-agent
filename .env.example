# Backend: "stub" (default, offline, no key) or "anthropic" (live)
LLM_BACKEND=stub

# Required only when LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=

# Sprint 5 — Customer.io. Without this, sync runs in dry-run mode and
# writes the exact payload to out/syncs/ instead of calling the API.
CUSTOMERIO_APP_API_KEY=

# Sprint 4 — Slack intake
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
PREVIEW_BASE_URL=https://email-agent.internal/preview
